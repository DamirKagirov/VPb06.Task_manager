# Скопируйте этот файл в .env и подставьте свой токен.
# Токен выдаёт @BotFather в Telegram (команда /newbot).
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Необязательно: путь к файлу базы данных.
# По умолчанию используется data/tasks.db рядом с проектом.
# DB_PATH=data/tasks.db

# Необязательно: прокси, если api.telegram.org недоступен напрямую.
# Поддерживаются socks5:// и http:// (с логином/паролем или без).
# PROXY_URL=socks5://127.0.0.1:1080
